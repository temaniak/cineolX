+    struct Action {
+        alignas(std::max_align_t) unsigned char storage[128]{};
+        void (*invoke)(void *) = nullptr;
+
+        template <class F>
+        explicit Action(F action) {
+            static_assert(std::is_trivially_copyable_v<F>);
+            static_assert(sizeof(F) <= sizeof storage);
+            static_assert(alignof(F) <= alignof(std::max_align_t));
+            new (storage) F(std::move(action));
+            invoke = [](void *p) { (*std::launder(reinterpret_cast<F *>(p)))(); };
+        }
+
+        Action(const Action &other) : invoke(other.invoke) {
+            std::memcpy(storage, other.storage, sizeof storage);
+        }
+        Action &operator=(const Action &other) {
+            if (this != &other) {
+                std::memcpy(storage, other.storage, sizeof storage);
+                invoke = other.invoke;
+            }
+            return *this;
+        }
+        void operator()() { invoke(storage); }
+    };
